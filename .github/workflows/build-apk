
name: Build CallBlocker APK

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: android-actions/setup-android@v3
        with:
          accept-android-sdk-licenses: true
          packages: |
            platform-tools
            platforms;android-35
            build-tools;35.0.0

      - name: Install Gradle
        run: |
          curl -L https://services.gradle.org/distributions/gradle-8.9-bin.zip -o /tmp/gradle.zip
          unzip -q /tmp/gradle.zip -d /tmp

      - name: Prepare project
        run: |
          unzip -q CallBlockerAndroid_GitHub_Build.zip -d /tmp/cb
          cp -a /tmp/cb/CallBlockerAndroid/. .

      - name: Build APK
        run: /tmp/gradle-8.9/bin/gradle --no-daemon assembleDebug

      - uses: actions/upload-artifact@v4
        with:
          name: CallBlocker-APK
          path: app/build/outputs/apk/debug/app-debug.apk
